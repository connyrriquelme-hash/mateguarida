{
  "name": "mateguarida",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "db:local": "wrangler d1 execute mateguarida-db --local --file cloudflare/schema.sql",
    "db:remote": "wrangler d1 execute mateguarida-db --remote --file cloudflare/schema.sql",
    "db:seed:local": "wrangler d1 execute mateguarida-db --local --file cloudflare/seed-demo.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.124.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
