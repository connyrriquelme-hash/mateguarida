{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mateguarida-conny",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "routes": [
    { "pattern": "mateguarida.com", "custom_domain": true },
    { "pattern": "www.mateguarida.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mateguarida-db",
      "database_id": "d8adeadf-8362-4f03-805c-f59ef8b7fd9d"
    }
  ]
}
