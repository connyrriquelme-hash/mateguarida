{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mateguarida-conny",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "routes": [
    { "pattern": "mateguarida.com", "custom_domain": true },
    { "pattern": "www.mateguarida.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mateguarida-db",
      "database_id": "d8adeadf-8362-4f03-805c-f59ef8b7fd9d"
    }
  ],
  "vars": {
    // Datos publicos de la aplicacion de Cloudflare Access (no son secretos:
    // ambos van dentro del propio JWT). cloudflare/acceso.mjs los usa para
    // verificar la firma, el emisor y la audiencia del JWT de Access.
    // PENDIENTE: reemplazar con los valores reales de Zero Trust -> Access ->
    // Applications -> "Mateguarida — Panel docente" -> Overview. Con estos
    // valores de relleno, acceso.mjs rechaza todo /panel y /api/docente/*
    // a proposito (ACCESS_TEAM_DOMAIN/ACCESS_AUD_TAG vacios => obtenerDocente
    // devuelve null), en vez de validar contra un dominio o audiencia que no
    // corresponden.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD_TAG": ""
  }
}
